{
  "sites": {
    "replica": {
      "baseUrl": "http://localhost:3000"
    },
    "original": {
      "baseUrl": "https://www.bradyperron.com"
    }
  },
  "pages": [
    {
      "name": "home",
      "paths": {
        "replica": "/",
        "original": "/"
      }
    }
  ],
  "breakpoints": [
    { "name": "390-mobile", "width": 390, "height": 844, "mobile": true },
    { "name": "768-tablet", "width": 768, "height": 1024, "mobile": true },
    { "name": "1440-desktop", "width": 1440, "height": 900, "mobile": false },
    { "name": "1920-wide", "width": 1920, "height": 1080, "mobile": false }
  ],
  "compare": {
    "submitBreakpoints": ["390-mobile", "1440-desktop"],
    "outputDir": "screenshots",
    "omissions": {
      "home": {
        "mobile": [],
        "desktop": []
      }
    },
    "navComparison": {
      "enabled": true,
      "checks": [
        "brand-position",
        "view-toggle",
        "about-control",
        "fixed-bottom-positioning"
      ]
    },
    "animationComparison": {
      "enabled": true,
      "types": ["page-load", "scroll", "hover"]
    }
  },
  "animations": {
    "targets": [
      {
        "page": "home",
        "selectors": [
          ".loader",
          "[data-view=\"grid\"]",
          "[data-view=\"list\"]",
          ".layout-name",
          ".bottom-control",
          ".project-modal",
          "[data-modal-scroll=\"true\"]"
        ]
      }
    ],
    "breakpoints": ["390-mobile", "1440-desktop"],
    "outputDir": "screenshots/animations",
    "hover": {
      "selectors": ["button", "a", ".bottom-control"],
      "burstFrames": 5,
      "burstInterval": 100,
      "cooldown": 300,
      "captureRadius": 50
    },
    "scroll": {
      "stepSize": 300,
      "settleTime": 500,
      "burstFrames": 3,
      "burstInterval": 150,
      "selectors": [
        "[data-view=\"grid\"]",
        "[data-view=\"list\"]",
        ".project-modal",
        "[data-modal-scroll=\"true\"]"
      ]
    }
  }
}
